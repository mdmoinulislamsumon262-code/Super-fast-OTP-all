# Required Telegram settings (set these in Render → Environment, never in code)
BOT_TOKEN=put_your_telegram_bot_token_here
ADMIN_ID=put_your_numeric_telegram_user_id_here

# Persistent storage for the SQLite database (Render disk mount path)
DATA_DIR=/var/data

# Optional external panel URL overrides
# YESMS_BASE_URL=https://yesms.online/api
# STEXSMS_BASE_URL=https://api.2oo9.cloud/MXS47FLFX0U/tness/@public/api
